    "@codemirror/view": "^6.43.13",
    "@lezer/highlight": "^1.2.4",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
