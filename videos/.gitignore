node_modules/
out/
# Licensed / downloaded audio stays out of git (see public/audio/*/music/README.md)
public/audio/**/*.mp3
public/audio/**/*.wav

# Tool caches and render outputs: regenerate them, don't commit them
kubesim-promo/.thumbnails/
kubesim-promo/.waveform-cache/
kubesim-promo/.hyperframes/preview/
kubesim-promo/renders/
kubesim-promo/snapshots/
# Uncut source / alternate music: only the edited track.mp3 is used
kubesim-promo/assets/bgm/source-*.mp3
kubesim-promo/assets/bgm/track-*.mp3

# Third-party audio (HeyGen library): not redistributable under this repo's MIT
# license. Keep your local copies; see kubesim-promo/assets/AUDIO.md.
kubesim-promo/assets/bgm/
kubesim-promo/assets/sfx/

# Agent work packets generated by the hyperframes tooling (contain local paths)
kubesim-promo/.hyperframes/frame-packets/
